<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!--
    公証には Hardened Runtime が必須で、そのままだと JIT や
    ユーザー選択ファイルの読み取りが弾かれる。Stash に必要なのは次の 3 つだけ。
  -->

  <!-- WKWebView（JavaScriptCore）の JIT -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>

  <!-- webview が確保する書き込み可能な実行メモリ -->
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>

  <!--
    素材はユーザーが選んだ任意の場所にあり、その絶対パスを保持して読み書きする。
    サンドボックスは有効にしていないので実際にはこれで足りるが、
    将来 App Store 配布（サンドボックス必須）に進む場合はここが起点になる。
  -->
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
</dict>
</plist>
